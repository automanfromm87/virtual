load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Asset import. Pure C++20 and no third-party code, which is why the JSON
# reader lives here too — glTF needs one and the engine takes no dependencies.
# JSON on its own: the scene serialiser wants a reader and a writer, and has no
# business pulling in a glTF importer to get them.
cc_library(
    name = "json",
    srcs = ["json.cc"],
    hdrs = ["json.h"],
)

# PNG, with the DEFLATE decompressor it needs. Separate from the glTF reader:
# an importer wants both, but a texture loader wants only this.
cc_library(
    name = "png",
    srcs = ["png.cc"],
    hdrs = ["png.h"],
    deps = ["//engine/texture"],
)

# Baseline JPEG. Separate from :png for the same reason :png is separate from
# :asset -- a texture loader may want one, the other, or both.
cc_library(
    name = "jpeg",
    srcs = ["jpeg.cc"],
    hdrs = ["jpeg.h"],
    deps = [":png"],
)

cc_test(
    name = "jpeg_test",
    srcs = [
        "jpeg_test.cc",
        "testdata_jpeg.inc",
    ],
    deps = [":jpeg"],
)

cc_library(
    name = "asset",
    srcs = ["gltf.cc"],
    hdrs = ["gltf.h"],
    deps = [
        ":json",
        ":jpeg",
        ":png",
        "//engine/anim",
        "//engine/core",
        "//engine/geometry",
    ],
)

# The fixture, exposed so demos can import a real glTF document without
# shipping a file the binary has to find at runtime.
cc_library(
    name = "testdata",
    textual_hdrs = [
        "testdata_quad_gltf.inc",
        "testdata_glb.inc",
        "testdata_skinned_gltf.inc",
        "testdata_morph_gltf.inc",
        "testdata_textured_gltf.inc",
    ],
)

cc_test(
    name = "json_test",
    srcs = ["json_test.cc"],
    deps = [":json"],
)

cc_test(
    name = "png_test",
    srcs = [
        "png_test.cc",
        # Real PNG files, generated once by an independent encoder and checked
        # in. In srcs, not data: they are #include'd as C arrays.
        "testdata_png.inc",
    ],
    deps = [":png"],
)

cc_test(
    name = "gltf_test",
    srcs = [
        "gltf_test.cc",
        # A real glTF 2.0 document with an embedded base64 buffer, generated
        # once and checked in — beats depending on an exporter being installed.
        # In srcs, not data: it is #include'd, so it is a compile-time input.
        "testdata_quad_gltf.inc",
        "testdata_textured_gltf.inc",
        "testdata_glb.inc",
        "testdata_skinned_gltf.inc",
        "testdata_morph_gltf.inc",
        "testdata_fox.inc",
    ],
    deps = [":asset"],
)

# The baked package format, and the file watcher an editor loop needs.
#
# Separate from :asset because they are the opposite half of the pipeline: the
# importers turn interchange formats into engine data, and this turns engine
# data into something that loads without parsing.
cc_library(
    name = "pack",
    srcs = [
        "hotreload.cc",
        "pack.cc",
    ],
    hdrs = [
        "hotreload.h",
        "pack.h",
    ],
    deps = [
        "//engine/core",
        "//engine/geometry",
        "//engine/shaders",
    ],
)

cc_test(
    name = "pack_test",
    srcs = ["pack_test.cc"],
    deps = [":pack"],
)

# Procedural surface textures. Depends on nothing but the maths: it computes
# pixels, and whoever wants them on the GPU uploads them.
cc_library(
    name = "texgen",
    srcs = ["texgen.cc"],
    hdrs = ["texgen.h"],
    deps = ["//engine/core"],
)

cc_library(
    name = "soundgen",
    srcs = ["soundgen.cc"],
    hdrs = ["soundgen.h"],
    deps = ["//engine/audio"],
)

cc_test(
    name = "soundgen_test",
    size = "small",
    srcs = ["soundgen_test.cc"],
    deps = [":soundgen"],
)

cc_test(
    name = "texgen_test",
    size = "small",
    srcs = ["texgen_test.cc"],
    deps = [
        ":png",
        ":texgen",
    ],
)
