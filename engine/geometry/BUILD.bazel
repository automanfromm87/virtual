load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Pure C++20 mesh generation. Produces plain vertex/index arrays plus a bounding
# sphere — no Metal, no platform code — so it is testable without a GPU.
cc_library(
    name = "geometry",
    srcs = [
        "simplify.cc",
        "terrain.cc",
        "floorplan.cc",
        "hull.cc",
        "mesh.cc",
        "meshlet.cc",
        "tree.cc",
    ],
    hdrs = [
        "simplify.h",
        "terrain.h",
        "floorplan.h",
        "hull.h",
        "mesh.h",
        "meshlet.h",
        "tree.h",
    ],
    deps = [
        "//engine/core",
        "//engine/shaders",
    ],
)

cc_test(
    name = "mesh_test",
    srcs = ["mesh_test.cc"],
    deps = [":geometry"],
)

cc_test(
    name = "floorplan_test",
    srcs = ["floorplan_test.cc"],
    deps = [":geometry"],
)

cc_test(
    name = "hull_test",
    srcs = ["hull_test.cc"],
    deps = [":geometry"],
)

cc_test(
    name = "simplify_test",
    srcs = ["simplify_test.cc"],
    deps = [":geometry"],
)

cc_test(
    name = "terrain_test",
    srcs = ["terrain_test.cc"],
    deps = [":geometry"],
)

# Meshlets, on the CPU. The bounds and the normal cone are exact arithmetic and
# a hole in a model is what a wrong one produces, so they are checked here
# rather than by looking at a render.
cc_test(
    name = "meshlet_test",
    srcs = ["meshlet_test.cc"],
    deps = [":geometry"],
)

# Procedural trees. "Does it look like a tree" is not testable and is not what
# breaks -- two seeds giving the same tree, the recursion exploding, and
# inverted normals are, and all three are arithmetic.
cc_test(
    name = "tree_test",
    srcs = ["tree_test.cc"],
    deps = [":geometry"],
)
