load("@rules_cc//cc:defs.bzl", "cc_test", "objc_library")

package(default_visibility = ["//visibility:public"])

# Windows, events, main loop. The only package that links AppKit — a headless
# CI machine never pulls this in, which is what keeps apps/headless provably
# window-server-free.
#
# Note it does NOT depend on //engine/rhi: it receives the native layer as an
# opaque void*, so the platform layer and the graphics API stay independent.
objc_library(
    name = "platform",
    srcs = [
        "font.mm",
        "window.mm",
    ],
    hdrs = [
        "font.h",
        "window.h",
    ],
    linkopts = [
        "-framework",
        "AppKit",
        "-framework",
        "QuartzCore",
        "-framework",
        "Foundation",
        # CoreText rasterises the font atlas; CoreGraphics is the bitmap
        # context it draws into.
        "-framework",
        "CoreText",
        "-framework",
        "CoreGraphics",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# The speaker, split out and DEPENDENCY-FREE. It is here rather than in
# engine/audio because it is the OS's, and it is not in :platform because a
# target that opens a window has no business linking an audio unit.
objc_library(
    name = "audio_out",
    srcs = ["audio_out.mm"],
    hdrs = ["audio_out.h"],
    linkopts = [
        "-framework",
        "AudioToolbox",
        "-framework",
        "Foundation",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# Controllers, through GameController. A separate target because a gamepad is
# not attached to a window: a headless tool that reads one should not have to
# link AppKit, and :platform should not grow a framework for a device it does
# not own.
objc_library(
    name = "gamepad",
    srcs = ["gamepad.mm"],
    hdrs = ["gamepad.h"],
    linkopts = [
        "-framework",
        "GameController",
        "-framework",
        "Foundation",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

cc_test(
    name = "gamepad_test",
    srcs = ["gamepad_test.cc"],
    deps = [":gamepad"],
)
