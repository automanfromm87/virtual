load("@rules_cc//cc:defs.bzl", "objc_library")

package(default_visibility = ["//visibility:public"])

# The Render Hardware Interface. The only package that links Metal, and the
# only one whose sources may be .mm.
#
# Deliberately depends on NOTHING inside the engine — not core, not scene. An
# RHI that reaches upward is not an RHI.
objc_library(
    name = "rhi",
    srcs = ["rhi_metal.mm"],
    hdrs = ["rhi.h"],
    linkopts = [
        "-framework",
        "Metal",
        "-framework",
        "Foundation",
        "-framework",
        "QuartzCore",
        # CoreGraphics for the extended-linear colour space an HDR layer needs;
        # it is only for HDR output and used nowhere else. AppKit used to be
        # here for the screen's reported headroom, but that query moved to
        # platform::DisplayHeadroom -- the RHI links no window-server framework.
        "-framework",
        "CoreGraphics",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)
