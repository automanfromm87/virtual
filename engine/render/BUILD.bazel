load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# cc_library, NOT objc_library — and that is the whole point of the RHI split.
# This layer decides what to draw and links no Apple framework at all. If a
# Metal type ever leaks up from engine/rhi, this rule stops compiling.
cc_library(
    name = "render",
    srcs = [
        "decals.cc",
        "fluid.cc",
        "ibl.cc",
        "particles.cc",
        "post.cc",
        "rendergraph.cc",
        "renderer.cc",
        "volumetric.cc",
    ],
    hdrs = [
        "decals.h",
        "fluid.h",
        "ibl.h",
        "particles.h",
        "post.h",
        "rendergraph.h",
        "renderer.h",
        "volumetric.h",
    ],
    copts = [
        # #embed is a C23 feature; clang accepts it in C++ mode but warns.
        "-Wno-c23-extensions",
    ],
    deps = [
        ":gi",
        "//engine/anim",
        "//engine/core",
        "//engine/geometry",
        "//engine/rhi",
        "//engine/resource",
        "//engine/scene",
        "//engine/shaders",
        "//engine/texture",
    ],
)

# Baked indirect light on a grid. On the CPU and separate from :render: a bake
# is not a frame, and every failure mode of a GI bake produces a picture that
# looks plausible -- so it has to be testable without a device.
cc_library(
    name = "gi",
    srcs = ["gi.cc"],
    hdrs = ["gi.h"],
    deps = [
        "//engine/core",
        "//engine/physics",
    ],
)

cc_test(
    name = "gi_test",
    srcs = ["gi_test.cc"],
    deps = [":gi"],
)
