load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# cc_library, NOT objc_library — and that is the whole point of the RHI split.
# This layer decides what to draw and links no Apple framework at all. If a
# Metal type ever leaks up from engine/rhi, this rule stops compiling.
#
# Split into one target per pass family rather than a single god target, so a
# change to a bloom threshold does not recompile the particle system and a
# reader can see which passes exist without opening renderer.cc. :render stays
# as the facade so the thirty demos and tests that consume "the renderer" keep
# depending on one name.
cc_library(
    name = "rendergraph",
    srcs = ["rendergraph.cc"],
    hdrs = ["rendergraph.h"],
    deps = ["//engine/rhi"],
)

cc_library(
    name = "passes",
    srcs = [
        "decals.cc",
        "ibl.cc",
        "post.cc",
        "volumetric.cc",
    ],
    hdrs = [
        "decals.h",
        "ibl.h",
        "post.h",
        "volumetric.h",
    ],
    copts = [
        # #embed is a C23 feature; clang accepts it in C++ mode but warns.
        "-Wno-c23-extensions",
    ],
    deps = [
        "//engine/core",
        "//engine/rhi",
        "//engine/scene",
        "//engine/shaders",
    ],
)

cc_library(
    name = "fx",
    srcs = [
        "fluid.cc",
        "particles.cc",
    ],
    hdrs = [
        "fluid.h",
        "particles.h",
    ],
    copts = [
        # #embed is a C23 feature; clang accepts it in C++ mode but warns.
        "-Wno-c23-extensions",
    ],
    deps = [
        "//engine/core",
        "//engine/geometry",
        "//engine/rhi",
        "//engine/scene",
        "//engine/shaders",
    ],
)

cc_library(
    name = "render",
    srcs = ["renderer.cc"],
    hdrs = ["renderer.h"],
    copts = [
        # #embed is a C23 feature; clang accepts it in C++ mode but warns.
        "-Wno-c23-extensions",
    ],
    deps = [
        ":fx",
        ":gi",
        ":passes",
        ":rendergraph",
        "//engine/anim",
        "//engine/core",
        "//engine/geometry",
        "//engine/rhi",
        "//engine/resource",
        "//engine/scene",
        "//engine/shaders",
        "//engine/texture",
    ],
)

# Baked indirect light on a grid. On the CPU and separate from :render: a bake
# is not a frame, and every failure mode of a GI bake produces a picture that
# looks plausible -- so it has to be testable without a device.
cc_library(
    name = "gi",
    srcs = ["gi.cc"],
    hdrs = ["gi.h"],
    deps = [
        "//engine/core",
        "//engine/physics",
    ],
)

cc_test(
    name = "gi_test",
    srcs = ["gi_test.cc"],
    deps = [":gi"],
)
