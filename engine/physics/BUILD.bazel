load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Rigid body dynamics. Pure C++20 and no GPU, so every property below is
# checkable exactly rather than by looking at a picture.
cc_library(
    name = "physics",
    srcs = [
        "bvh.cc",
        "character.cc",
        "physics.cc",
    ],
    hdrs = [
        "bvh.h",
        "character.h",
        "physics.h",
    ],
    deps = [
        "//engine/core",
        # Hull collision shapes come from the hull builder, and their mass
        # properties are computed there rather than approximated here.
        "//engine/geometry",
    ],
)

cc_test(
    name = "physics_test",
    srcs = ["physics_test.cc"],
    deps = [":physics"],
)

cc_test(
    name = "bvh_test",
    srcs = ["bvh_test.cc"],
    deps = [":physics"],
)

# Terrain as a physics body. The point of the test is agreement: the renderer's
# terrain, the collider and the raycast all have to return the same surface, or
# a character's feet sink into ground that is visibly solid.
cc_test(
    name = "heightfield_test",
    srcs = ["heightfield_test.cc"],
    deps = [
        ":physics",
        "//engine/geometry",
    ],
)
