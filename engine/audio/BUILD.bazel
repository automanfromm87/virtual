load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Pure C++20. No CoreAudio, no hardware -- the mixing arithmetic is the part
# that can be wrong, and it is all testable without a speaker.
cc_library(
    name = "audio",
    srcs = [
        "mixer.cc",
        "wav.cc",
    ],
    hdrs = [
        "clip.h",
        "mixer.h",
        "wav.h",
    ],
    deps = ["//engine/core"],
)

cc_test(
    name = "wav_test",
    srcs = ["wav_test.cc"],
    deps = [":audio"],
)

cc_test(
    name = "mixer_test",
    srcs = ["mixer_test.cc"],
    deps = [":audio"],
)

# The front end, which needs the speaker and so cannot be pure the way :audio
# is. Everything testable lives next door on purpose.
cc_library(
    name = "system",
    srcs = ["system.cc"],
    hdrs = [
        "queue.h",
        "system.h",
    ],
    deps = [
        ":audio",
        "//engine/platform:audio_out",
    ],
)

cc_test(
    name = "queue_test",
    srcs = ["queue_test.cc"],
    deps = [":system"],
)

# The layer between the game and the mixer: the command queue, the handle
# table, and the order Drain does things in. None of it needs a speaker --
# CreateSilent and RenderForTest exist so it can be driven a block at a time --
# and every bug found in it so far was invisible from mixer_test.
cc_test(
    name = "system_test",
    srcs = ["system_test.cc"],
    deps = [":system"],
)
