load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Header-only handle types. Depends on nothing, on purpose: it exists so that
# engine/scene and engine/render can refer to the same resources without either
# one depending on the other.
cc_library(
    name = "resource",
    hdrs = ["handles.h"],
)

# Streaming residency: what should be in memory, loaded in the background,
# evicted under a budget. No graphics in it -- the caller supplies the loader
# and does the upload, so this is a scheduling problem and testable as one.
cc_library(
    name = "stream",
    srcs = ["stream.cc"],
    hdrs = ["stream.h"],
    deps = ["//engine/core"],
)

cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    deps = [":stream"],
)
