load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gallery_scene",
    hdrs = ["gallery_scene.h"],
    deps = [
        "//apps/skinned:skinned_scene",
        "//engine/anim",
        "//engine/asset",
        "//engine/geometry",
        "//engine/render",
        "//engine/scene",
        "//engine/texture",
    ],
)

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":gallery_scene",
        "//engine/app",
        "//engine/render",
    ],
)

cc_binary(
    name = "offscreen",
    srcs = ["offscreen.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":gallery_scene",
        "//engine/app:targets",
        "//engine/render",
        "//engine/rhi",
    ],
)

cc_test(
    name = "gallery_test",
    srcs = ["offscreen.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":gallery_scene",
        "//engine/app:targets",
        "//engine/render",
        "//engine/rhi",
    ],
)
