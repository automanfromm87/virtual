load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

# Everything at once. The other demos each show one system; the interesting
# failures are BETWEEN systems -- the navmesh and the collider disagreeing about
# where the ground is, the sky and the fog disagreeing about the distance -- and
# none of those is visible in a demo that has only one of the two.
cc_binary(
    name = "world",
    srcs = ["districts.h", "viewer.cpp"],
    deps = [
        "//engine/app",
        "//engine/asset:png",
        "//engine/asset:texgen",
        "//engine/geometry",
        "//engine/nav",
        "//engine/physics",
        "//engine/platform",
        "//engine/render",
        "//engine/text:ui",
    ],
)
