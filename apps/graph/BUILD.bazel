load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

# Two-pass frame through the render graph. The only target where pass ORDER is
# derived rather than hand-written, and the only one that proves it.
cc_binary(
    name = "graph",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)

cc_test(
    name = "graph_test",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)
