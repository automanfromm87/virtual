load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

# Clustered lighting: the same picture, and a cheaper one. Both are checked --
# an optimisation that changes the image is not one.
cc_test(
    name = "lights_test",
    srcs = ["main.cpp"],
    deps = [
        "//engine/geometry",
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
        "//engine/shaders",
    ],
)

# The same feature, to look at rather than to measure. Dozens of point lights
# you can see -- they are emissive spheres -- with the frame time on screen and
# clustering on a key.
cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    deps = [
        "//engine/app",
        "//engine/geometry",
        "//engine/platform",
        "//engine/render",
        "//engine/shaders",
        "//engine/text:ui",
    ],
)
