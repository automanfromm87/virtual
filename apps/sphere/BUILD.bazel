load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

# Offscreen sphere render with orientation-sensitive pixel checks. This is the
# target that proves the depth buffer, back-face culling and normals are all
# wired up — none of which the triangle exercises.
cc_binary(
    name = "sphere",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//engine/render"],
)

cc_test(
    name = "sphere_render_test",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//engine/render"],
)
