load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

# Multi-object depth-ordering check. This is the only target that can fail if
# the depth buffer or the reversed-Z convention is wrong.
cc_binary(
    name = "scene",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/render",
        "//engine/scene",
    ],
)

cc_test(
    name = "occlusion_test",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/render",
        "//engine/scene",
    ],
)
