load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:public"])

# Shadow mapping via the render graph. The first frame with a pass that reads
# what another pass wrote, so the graph's ordering is load-bearing here.
cc_binary(
    name = "shadow",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/geometry",
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)

cc_test(
    name = "shadow_test",
    srcs = ["main.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//engine/geometry",
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)
