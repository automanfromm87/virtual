load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# A procedurally generated skinned tentacle. Generated rather than imported so
# every vertex's weights come from a formula the test can also evaluate.
cc_library(
    name = "skinned_scene",
    hdrs = ["skinned_scene.h"],
    deps = [
        "//engine/anim",
        "//engine/geometry",
        "//engine/render",
        "//engine/scene",
    ],
)

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":skinned_scene",
        "//engine/app",
        "//engine/render",
    ],
)

cc_binary(
    name = "offscreen",
    srcs = ["offscreen.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":skinned_scene",
        "//engine/asset",
        "//engine/asset:testdata",
        "//engine/render",
        "//engine/rhi",
    ],
)

cc_test(
    name = "skinned_test",
    srcs = ["offscreen.cpp"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":skinned_scene",
        "//engine/asset",
        "//engine/asset:testdata",
        "//engine/render",
        "//engine/rhi",
    ],
)
