load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# Single-pass stereo. The claim is not "it renders two images" -- two passes do
# that -- but that one pass produces the same two images for less.
cc_test(
    name = "stereo_test",
    srcs = ["main.cpp"],
    deps = [
        "//engine/geometry",
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)
