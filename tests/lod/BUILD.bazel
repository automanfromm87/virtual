load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# Levels of detail and occlusion culling: both invisible when they work and
# invisible when they do not, so both are read back from the GPU.
cc_test(
    name = "lod_test",
    tags = ["exclusive"],
    target_compatible_with = ["@platforms//os:macos"],
    srcs = ["offscreen.cpp"],
    deps = [
        "//engine/geometry",
        "//engine/render",
        "//engine/rhi",
        "//engine/scene",
    ],
)
